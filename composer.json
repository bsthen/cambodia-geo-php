{
    "name": "bsthen/cambodia-geo",
    "description": "Lightweight, zero-dependency lookup of Cambodia's provinces, districts, communes and villages (Khmer, English, codes).",
    "type": "library",
    "license": "MIT",
    "keywords": ["cambodia", "khmer", "geo", "province", "district", "commune", "village", "administrative-divisions"],
    "homepage": "https://github.com/bsthen/cambodia-geo-php",
    "authors": [
        { "name": "bsthen" }
    ],
    "support": {
        "issues": "https://github.com/bsthen/cambodia-geo-php/issues",
        "source": "https://github.com/bsthen/cambodia-geo-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-intl": "Unicode NFC normalisation of search queries (recommended)"
    },
    "autoload": {
        "psr-4": {
            "CambodiaGeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CambodiaGeo\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "build-data": "@php scripts/build-data.php",
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
